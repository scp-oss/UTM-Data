# Скопируйте этот файл в .env и заполните под себя:
#   cp .env.example .env
#
# .env читает docker-compose.yml; сам файл .env в репозиторий не коммитится
# (см. .gitignore) — секреты остаются только на вашем сервере.

# Порт на хосте, под которым будет доступен дашборд (нестандартный порт,
# если 8088 уже занят другим сервисом).
DASHBOARD_PORT=8088

# Пароль администратора — без него управление УТМ и настройки открыты
# для всех, у кого есть доступ к дашборду. Обязательно задайте на проде.
ADMIN_PASSWORD=

# Часовой пояс сервера — влияет на то, как трактуется время опроса,
# заданное на странице «Настройки».
TZ=Europe/Moscow
